{
  "name": "clima-app",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/build-service-worker.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && npm run lint:styles",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "build:pages": "ng build --base-href /clima-app/ && node scripts/build-service-worker.mjs",
    "test:ci": "ng test --watch=false",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "lint-staged": {
    "*.{ts,html}": ["eslint --fix", "prettier --write"],
    "*.scss": ["stylelint --fix", "prettier --write"]
  }
}
